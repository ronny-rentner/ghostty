#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export ZIG_GLOBAL_CACHE_DIR = $(CURDIR)/build/zig-global-cache
export ZIG_LOCAL_CACHE_DIR = $(CURDIR)/build/zig-local-cache
GHOSTTY_VERSION ?= $(shell cat VERSION)
ZIG ?= zig0.17

%:
	dh $@

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/ghostty $(ZIG) build \
		--summary all \
		--prefix /usr \
		--system $(abspath ../zig/cache/packages) \
		-fsys=highway \
		-fsys=glslang \
		-fsys=spirv-cross \
		-fsys=simdutf \
		-Doptimize=ReleaseFast \
		-Dstrip=true \
		-Dcpu=baseline \
		-Dpie=true \
		-Demit-docs \
		-Dversion-string=$(GHOSTTY_VERSION)

	# Use Debian's directory for packaged zsh completions.
	mv debian/ghostty/usr/share/zsh/site-functions debian/ghostty/usr/share/zsh/vendor-completions
