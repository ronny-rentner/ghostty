+pub const DesktopNotifications = packed struct {
+    desktop: bool = false,
+    bell: bool = false,
+
+    pub fn parseCLI(input_: ?[]const u8) !DesktopNotifications {
+        const input = input_ orelse "true";
+        // Preserve the original boolean setting: true enables only desktop notifications.
+        const desktop = cli.args.parseBool(input) catch
+            return cli.args.parsePackedStruct(DesktopNotifications, input);
+        return .{ .desktop = desktop };
+    }
+};
