             gobject.ext.ensureType(SplitTree);
             gobject.ext.ensureType(Surface);
             gobject.ext.ensureType(Tab);
+            // AdwTabBar exposes its header only as the sender of query-tooltip.
+            _ = gobject.signalAddEmissionHook(gobject.signalLookup("query-tooltip", gtk.Widget.getGObjectType()), 0, tabTooltipHook, null, null);
