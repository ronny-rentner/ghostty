+test "preedit forwarding mode reports enable disable and reset" {
+    var state: ModeState = .{};
+    try testing.expect(!state.get(.preedit_forwarding));
+    try testing.expect(!defaultConfigurable(.preedit_forwarding));
+    for ([_]bool{ false, true, false }) |enabled| {
+        state.set(.preedit_forwarding, enabled);
+        const report = state.getReport(.{ .value = 2035 });
+        var buf: [Report.max_size]u8 = undefined;
+        var writer: std.Io.Writer = .fixed(&buf);
+        try report.encode(&writer);
+        try testing.expectEqualStrings(
+            if (enabled) "\x1b[?2035;1$y" else "\x1b[?2035;2$y",
+            writer.buffered(),
+        );
+    }
+    state.set(.preedit_forwarding, true);
+    state.reset();
+    try testing.expect(!state.get(.preedit_forwarding));
+}
