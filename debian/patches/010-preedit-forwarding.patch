 const test_hangul_ga: u21 = 0xAC00; // U+AC00 HANGUL SYLLABLE GA
 
+test "preedit forwarding hides the overlay until disabled" {
+    const testing = std.testing;
+    var terminal = try terminalpkg.Terminal.init(testing.io, testing.allocator, .{ .cols = 10, .rows = 5 });
+    defer terminal.deinit(testing.allocator);
+    var mutex: std.Io.Mutex = .init;
+    const state: State = .{
+        .mutex = &mutex,
+        .terminal = &terminal,
+        .preedit = .{ .codepoints = &.{.{ .codepoint = 'a' }} },
+    };
+
+    try testing.expect(state.preeditForRender() != null);
+    terminal.modes.set(.preedit_forwarding, true);
+    try testing.expect(state.preeditForRender() == null);
+    terminal.modes.set(.preedit_forwarding, false);
+    try testing.expectEqual(@as(u21, 'a'), state.preeditForRender().?.codepoints[0].codepoint);
+}
