+    /// Returns the one direction the precision scroll in progress is locked to,
+    /// deciding it on the scroll's first event, or null when no lock applies:
+    /// horizontal tab scrolling is enabled, or no precision scroll is in progress.
+    fn scrollAxisLock(self: *Self, ec: *gtk.EventControllerScroll) ?ScrollAxis {
+        const priv: *Private = self.private();
+        if (!priv.precision_scroll) return null;
+
+        const tab_scroll_enabled = if (priv.config) |config|
+            config.get().@"gtk-horizontal-tab-scroll"
+        else
+            true;
+        if (tab_scroll_enabled) return null;
+
+        if (priv.scroll_axis) |axis| return axis;
+
+        const surface = priv.core_surface orelse return null;
+        const deltas = scrollEventDeltas(ec) orelse return null;
+
+        // Without mouse reporting the terminal scrolls vertically only, so there
+        // is no second direction; with it, the larger part of the first event decides
+        const axis: ScrollAxis = if (surface.mouseReportingActive() and @abs(deltas.x) > @abs(deltas.y))
+            .horizontal
+        else
+            .vertical;
+        priv.scroll_axis = axis;
+        return axis;
+    }
+
+    /// Returns both deltas of the scroll event being handled; each scroll
+    /// controller's own callback receives only the direction it is set up for.
+    fn scrollEventDeltas(ec: *gtk.EventControllerScroll) ?struct { x: f64, y: f64 } {
+        const event = ec.as(gtk.EventController).getCurrentEvent() orelse return null;
+        const scroll_event = gobject.ext.cast(gdk.ScrollEvent, event) orelse return null;
+        var x: f64 = 0;
+        var y: f64 = 0;
+        scroll_event.getDeltas(&x, &y);
+        return .{ .x = x, .y = y };
     }

     fn ecMouseScrollVertical(
-        _: *gtk.EventControllerScroll,
+        ec: *gtk.EventControllerScroll,
         x: f64,
         y: f64,
         self: *Self,
