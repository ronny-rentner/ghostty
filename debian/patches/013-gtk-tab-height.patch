Description: Keep GTK tab height stable when titles and bell indicators change
 Reserve space for bell indicators relative to the label font size.

diff --git a/src/apprt/gtk/css/style.css b/src/apprt/gtk/css/style.css
--- a/src/apprt/gtk/css/style.css
+++ b/src/apprt/gtk/css/style.css
@@ -4,6 +4,13 @@
  * https://gnome.pages.gitlab.gnome.org/libadwaita/doc/1.3/styles-and-appearance.html#custom-styles
  */
 
+/* Work around GTK's single-line label height bug in Adwaita tabs.
+ * Remove this override when GTK derives their height from the normal font alone.
+ */
+tabbox label {
+  min-height: 1.8em;
+}
+
